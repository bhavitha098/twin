# Copy this file to .env and fill in real values. .env is gitignored.

# Supabase project settings (Settings -> API)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase Settings -> Database -> Connection string (URI, includes password)
# Only needed to run supabase/schema.sql automatically via psql — not read by the app itself.
SUPABASE_DB_URL=

# console.anthropic.com API key, powers the real "Ask Civic Twin" AI answers.
# If unset, the AI box automatically falls back to rule-based answers.
ANTHROPIC_API_KEY=

PORT=4000
