# Copy this file to .env and fill in the real value. .env is gitignored.
#
# This app has NO backend — the frontend (public/) talks to Supabase
# directly using the public anon key baked into public/config.js. The only
# thing that still needs a local secret is applying schema/RLS changes.

# Supabase Settings -> Database -> Connection string (URI, includes password).
# Only used by `npm run db:migrate` (psql) to apply supabase/schema.sql —
# never read by the app itself, never shipped to the browser.
SUPABASE_DB_URL=

# Not used anywhere in this app anymore (no server holds it). Safe to leave
# unset. If you're security-conscious, you can rotate/revoke the
# service_role key in the Supabase dashboard since nothing depends on it.
# SUPABASE_SERVICE_ROLE_KEY=
